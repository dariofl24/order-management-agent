{
  "name": "order-management-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Demo ITESO: agente local con Ollama, Gemma 3 y herramientas validadas",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js",
    "test:live": "node --test tests/ollama.live.js",
    "format": "prettier --write src tests scripts",
    "format:check": "prettier --check src tests scripts"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "ollama": "0.6.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
